{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "nimo 任务状态机",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "docs/diagrams/task-states.html"
  },
  "lanes": [
    { "id": "main", "label": "主流程" },
    { "id": "wait", "label": "等待与阻塞" },
    { "id": "terminal", "label": "终止" }
  ],
  "states": [
    { "id": "start", "type": "start", "label": "start", "sublabel": "任务开始", "lane": "main", "col": 0, "tag": "entry" },
    { "id": "running", "type": "active", "label": "running", "sublabel": "执行中", "lane": "main", "col": 3, "tag": "active" },
    { "id": "delivered", "type": "success", "label": "delivered", "sublabel": "交付产物及独立质量结论", "lane": "main", "col": 4, "tag": "done" },
    { "id": "waiting", "type": "waiting", "label": "waitingInput", "sublabel": "需要真实产品决定", "lane": "wait", "col": 0, "tag": "wait" },
    { "id": "paused", "type": "waiting", "label": "paused", "sublabel": "用户暂停或宿主无法续跑", "lane": "wait", "col": 1, "tag": "pause" },
    { "id": "blocked", "type": "failure", "label": "blocked", "sublabel": "必要前提不可用", "lane": "wait", "col": 2, "tag": "recover" },
    { "id": "cancelled", "type": "failure", "label": "cancelled", "sublabel": "用户取消", "lane": "terminal", "col": 1, "tag": "terminal" }
  ],
  "transitions": [
    { "id": "t-start", "from": "start", "to": "running", "variant": "emphasis", "route": "straight" },
    { "id": "t-deliver", "from": "running", "to": "delivered", "variant": "emphasis", "route": "straight" },
    { "id": "t-run-wait", "from": "running", "to": "waiting", "variant": "default" },
    { "id": "t-wait-run", "from": "waiting", "to": "running", "variant": "emphasis" },
    { "id": "t-run-pause", "from": "running", "to": "paused", "variant": "default" },
    { "id": "t-pause-run", "from": "paused", "to": "running", "variant": "emphasis" },
    { "id": "t-run-blocked", "from": "running", "to": "blocked", "variant": "security" },
    { "id": "t-blocked-run", "from": "blocked", "to": "running", "variant": "emphasis" },
    { "id": "t-wait-cancel", "from": "waiting", "to": "cancelled", "variant": "security" },
    { "id": "t-blocked-cancel", "from": "blocked", "to": "cancelled", "variant": "security" },
    { "id": "t-pause-cancel", "from": "paused", "to": "cancelled", "variant": "security" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "主流程",
      "items": [
        "start → running：任务开始进入执行",
        "running → delivered：交付产物及独立质量结论"
      ]
    },
    {
      "dot": "amber",
      "title": "等待与恢复",
      "items": [
        "waitingInput：需要真实产品决定，得到有效回答后回到 running",
        "paused：用户暂停或宿主无法续跑，明确恢复并核对现场后回到 running",
        "blocked：必要前提不可用，前提恢复并重新核实后回到 running"
      ]
    },
    {
      "dot": "rose",
      "title": "终止",
      "items": [
        "cancelled：用户取消；waitingInput、paused、blocked 均可进入",
        "状态不启动工具、不授予权限；等待没有超时默认批准"
      ]
    }
  ]
}
